.profile-page{padding-bottom:190rpx}.identity-panel{margin-top:26rpx;border:2rpx solid #c9c2b5;border-left:8rpx solid #356447;background:#fffcf6}.identity-main{display:flex;align-items:center;gap:20rpx;padding:28rpx 26rpx}.avatar{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;background:#356447;color:#fff;font-family:"STSong","SimSun",serif;font-size:34rpx;font-weight:700}.identity-copy{min-width:0;flex:1}.profile-name,.profile-role{display:block}.profile-name{font-family:"STSong","SimSun",serif;font-size:34rpx;font-weight:700}.profile-role{overflow:hidden;margin-top:8rpx;color:#667068;font-size:21rpx;line-height:1.45;text-overflow:ellipsis;white-space:nowrap}.account-state{flex:none;padding:6rpx 12rpx;background:#e2ece3;color:#31513b;font-size:20rpx}.work-summary{display:grid;grid-template-columns:repeat(3,1fr);border-top:2rpx solid #ddd7cb;background:#f7f3ea}.summary-item{padding:20rpx 8rpx;border-left:2rpx solid #ddd7cb;text-align:center}.summary-item:first-child{border-left:0}.summary-value,.summary-label{display:block}.summary-value{color:#254332;font-family:"STSong","SimSun",serif;font-size:34rpx;font-weight:700}.summary-label{margin-top:5rpx;color:#747c76;font-size:19rpx}.section-heading{display:flex;align-items:flex-end;justify-content:space-between;margin:34rpx 0 14rpx;padding-left:14rpx;border-left:6rpx solid #c58a2b}.section-heading-title{font-size:27rpx;font-weight:700}.section-heading-note{color:#778078;font-size:19rpx}.section-heading-account{margin-top:38rpx}.app-entry-list{display:grid;gap:14rpx}.app-entry{display:flex;box-sizing:border-box;width:100%;min-height:112rpx;align-items:center;gap:20rpx;padding:18rpx 22rpx;border:2rpx solid #d0c9bc;background:#fffcf6;color:#17211b;text-align:left}.app-entry-active{background:#f0ece3}.app-icon{display:flex;width:60rpx;height:60rpx;flex:none;align-items:center;justify-content:center;background:#dfe9e0;color:#315c43;font-size:25rpx;font-weight:700}.app-icon-performance{background:#efe2c7;color:#80551d}.app-copy{min-width:0;flex:1}.app-title,.app-description{display:block}.app-title{font-size:27rpx;font-weight:700}.app-description{margin-top:7rpx;color:#687169;font-size:21rpx;line-height:1.4}.app-chevron{width:14rpx;height:14rpx;flex:none;border-top:3rpx solid #627068;border-right:3rpx solid #627068;transform:rotate(45deg)}.info-list{border-top:2rpx solid #17211b}.info-row{display:flex;align-items:flex-start;justify-content:space-between;gap:30rpx;padding:21rpx 4rpx;border-bottom:2rpx solid #d6d0c5;font-size:23rpx}.info-label{flex:none;color:#727a74}.info-value{text-align:right;font-weight:700;line-height:1.5}.record-note{margin-top:28rpx;padding:22rpx 24rpx;border-left:6rpx solid #c58a2b;background:#f1e2c5}.record-note-title{font-size:24rpx;font-weight:700}.record-note-body{display:block;margin-top:9rpx;color:#524d43;font-size:21rpx;line-height:1.7}.privacy-link{width:100%;margin:20rpx 0 0;border:0;background:transparent;color:#356447;font-size:22rpx;text-align:left}.privacy-link::after{display:none}
.app-policy{display:block;margin-top:6rpx;color:#356447;font-size:20rpx;font-weight:700}.app-icon-food{background:#e7e1ce;color:#6f5727}
.identity-switch{margin:20rpx 0 28rpx;min-height:88rpx;border:1rpx solid #3f684f;border-radius:0;background:#fffdf8;color:#315c42;font-size:28rpx}.identity-switch::after{border:0}

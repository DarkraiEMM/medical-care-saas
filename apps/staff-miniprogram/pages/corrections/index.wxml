<view class="page-shell">
  <view class="test-banner">演示环境</view>
  <view class="section-title">
    <text class="title">待修改</text>
    <text class="sub">按照退回要求修改后重新提交，原记录继续保留</text>
  </view>

  <view wx:if="{{error}}" class="error-box">
    <text>{{error}}</text>
    <button class="inline-retry" bindtap="retry">重新连接</button>
  </view>
  <view wx:if="{{loading}}" class="empty-state">正在读取任务…</view>
  <view wx:elif="{{!tasks.length}}" class="empty-state">当前没有待修改任务</view>

  <view
    wx:for="{{tasks}}"
    wx:key="id"
    class="correction-card"
    data-id="{{item.id}}"
    bindtap="openTask"
  >
    <view>
      <text class="correction-name">{{item.elderName}}</text>
      <text class="correction-items">{{item.serviceItemsLabel}} · 第 {{item.revision}} 版</text>
    </view>
    <view class="correction-reason">
      <text class="correction-reason-title">需要修改</text>
      <block wx:if="{{item.returnIssues.length}}">
        <view wx:for="{{item.returnIssues}}" wx:for-item="issue" wx:key="fieldLabel">
          <text>{{issue.stage==='BEFORE'?'服务前':issue.stage==='DURING'?'服务中':'服务后'}} · {{issue.fieldLabel}}</text>
          <text>{{issue.reason}}</text>
        </view>
      </block>
      <text wx:else>{{item.returnReason}}</text>
    </view>
    <text class="correction-link">查看并修改</text>
  </view>
</view>

.correction-card{display:block;box-sizing:border-box;width:100%;min-width:0;margin-top:20rpx;padding:28rpx;border:2rpx solid #d0cabf;border-left:7rpx solid #b84a3a;border-radius:2rpx;background:#fffdf8;text-align:left}.correction-name,.correction-items{display:block}.correction-name{font-size:32rpx;font-weight:700}.correction-items{margin-top:7rpx;color:#6a746d;font-size:22rpx}.correction-reason{margin:20rpx 0;padding:18rpx;background:#f4dfdb;color:#7a302a;font-size:24rpx;line-height:1.65}.correction-reason-title{display:block;margin-bottom:5rpx;font-size:20rpx;font-weight:700}.correction-link{color:#3f684f;font-size:23rpx;font-weight:700}

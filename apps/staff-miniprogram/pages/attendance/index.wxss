.attendance-card{margin-top:28rpx;padding:28rpx;background:#fff;border:2rpx solid #d5cec0}.attendance-date{display:block;font-size:34rpx;font-weight:700}.attendance-policy{display:block;margin-top:10rpx;color:#6a746d;font-size:23rpx}.attendance-times{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin:28rpx 0}.attendance-times view{padding:24rpx;background:#f5f1e8}.attendance-times text{display:block}.attendance-times text+text{margin-top:10rpx;font-weight:700}.complete-state{padding:22rpx;background:#e1ece3;color:#294b34;text-align:center;font-weight:700}

<view class="page-shell"><view class="section-title"><text class="title">上下班考勤</text><text class="sub">与上门服务阶段记录分开统计</text></view><view wx:if="{{error}}" class="error-box"><text>{{error}}</text><button class="inline-retry" bindtap="retry">重新连接</button></view><view wx:if="{{loading}}" class="empty-state">正在读取今日考勤…</view><view wx:elif="{{attendance&&!attendance.enabled}}" class="empty-state">本机构未启用上下班考勤</view><view wx:elif="{{attendance}}" class="attendance-card"><text class="attendance-date">今日考勤</text><text class="attendance-policy">班次 {{attendance.policy.startTime}}—{{attendance.policy.endTime}} · 范围 {{attendance.policy.locationRadiusMeters}} 米</text><view class="attendance-times"><view><text>上班</text><text>{{attendance.record&&attendance.record.checkInAt?attendance.record.checkInAt:'未打卡'}}</text></view><view><text>下班</text><text>{{attendance.record&&attendance.record.checkOutAt?attendance.record.checkOutAt:'未打卡'}}</text></view></view><view wx:if="{{success}}" class="success-box">{{success}}</view><button wx:if="{{!attendance.record||!attendance.record.checkInAt}}" class="primary-button" loading="{{busy}}" data-action="CHECK_IN" bindtap="check">上班打卡</button><button wx:elif="{{!attendance.record.checkOutAt}}" class="primary-button" loading="{{busy}}" data-action="CHECK_OUT" bindtap="check">下班打卡</button><view wx:else class="complete-state">今日上下班打卡已完成</view></view></view>

.task-page{padding-bottom:180rpx}
.quick-apps{margin:24rpx 0 18rpx;padding:18rpx 20rpx 20rpx;border-left:6rpx solid #c58a2b;background:#eee4d1}
.quick-apps-active{background:#e5d8bf}
.quick-app-heading{display:flex;justify-content:space-between;margin-bottom:13rpx;color:#69685f;font-size:19rpx}
.quick-app-heading-title{color:#403e37;font-size:22rpx;font-weight:700}
.quick-app-heading-note{color:#74746b}
.quick-app-entry{display:flex;min-height:76rpx;align-items:center;gap:18rpx;padding:14rpx 16rpx;border:2rpx solid #d2cab9;background:#fffcf6;color:#17211b;text-align:left}
.quick-app-icon{display:flex;width:54rpx;height:54rpx;flex:none;align-items:center;justify-content:center;background:#356447;color:#fff;font-size:23rpx;font-weight:700}
.quick-app-copy{min-width:0;flex:1}
.quick-app-title,.quick-app-sub{display:block}
.quick-app-title{font-size:25rpx;font-weight:700}
.quick-app-sub{margin-top:5rpx;color:#6d746e;font-size:20rpx}
.quick-app-chevron{width:13rpx;height:13rpx;flex:none;border-top:3rpx solid #627068;border-right:3rpx solid #627068;transform:rotate(45deg)}
.task-overview{display:flex;gap:12rpx;margin:0 0 22rpx;padding:0 2rpx;color:#69736d;font-size:20rpx}
.overview-item{padding-right:12rpx;border-right:2rpx solid #c8c2b7}
.overview-item-last{border-right:0}
.task-list{display:block;width:100%}
.task-day-group{margin-bottom:30rpx}
.task-day-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:11rpx;padding:0 2rpx;color:#42564a}
.task-day-date{font-size:24rpx;font-weight:700}
.task-day-count{color:#7a837d;font-size:19rpx}
.task-card{display:grid;box-sizing:border-box;width:100%;min-width:0;grid-template-columns:106rpx minmax(0,1fr);margin:0 0 14rpx;border:2rpx solid #cbc4b8;border-left:7rpx solid #356447;background:#fffcf6;text-align:left}
.task-card-active{background:#f0ece3}
.task-time-rail{padding:25rpx 12rpx 22rpx 18rpx;border-right:2rpx solid #e0d9ce}
.task-time,.task-kind{display:block}
.task-time{color:#254332;font-size:29rpx;font-weight:700}
.task-kind{margin-top:10rpx;color:#778078;font-size:18rpx;line-height:1.45}
.task-content{min-width:0;padding:22rpx 20rpx}
.task-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}
.elder{min-width:0;font-family:"STSong","SimSun",serif;font-size:32rpx;font-weight:700}
.status{flex:none;padding:5rpx 11rpx;background:#dfe9e0;color:#31513b;font-size:19rpx}
.status-RETURNED{background:#f1dcd7;color:#8b392f}
.status-PENDING_REVIEW{background:#f2e6cd;color:#80551d}
.items{display:block;margin-top:9rpx;color:#3f4943;font-size:23rpx;line-height:1.5}
.team-line{display:grid;gap:5rpx;margin-top:15rpx;color:#69736d;font-size:19rpx;line-height:1.45}
.progress{display:flex;flex-wrap:wrap;align-items:center;gap:8rpx 13rpx;margin-top:17rpx;padding-top:14rpx;border-top:2rpx solid #e1dcd2;color:#647068;font-size:19rpx}
.revision{margin-left:auto}
.progress-dots{display:flex;gap:4rpx}
.progress-dot{display:block;width:12rpx;height:12rpx;border:2rpx solid #91a096;background:transparent}
.progress-dot.done{border-color:#356447;background:#356447}

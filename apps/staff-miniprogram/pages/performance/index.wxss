.performance-page{padding-bottom:150rpx}.policy-panel{margin-top:28rpx;padding:28rpx 24rpx;border-left:8rpx solid #356447;background:#fffcf6}.policy-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.policy-caption,.policy-name,.policy-departments,.policy-note{display:block}.policy-caption{color:#748077;font-size:20rpx}.policy-name{margin-top:7rpx;font-family:"STSong","SimSun",serif;font-size:31rpx;font-weight:700}.policy-score{flex:none;color:#315b40;font-family:"STSong","SimSun",serif;font-size:34rpx;font-weight:700}.policy-departments{margin-top:20rpx;padding-top:16rpx;border-top:2rpx solid #ddd6c9;color:#356447;font-size:21rpx;font-weight:700}.policy-note{margin-top:8rpx;color:#626c65;font-size:21rpx;line-height:1.65}.section-label{margin:34rpx 0 14rpx;padding-left:14rpx;border-left:6rpx solid #c58a2b;font-size:27rpx;font-weight:700}.rule-list{border-top:2rpx solid #17211b;background:#fffcf6}.rule-row{display:flex;align-items:center;justify-content:space-between;gap:22rpx;padding:23rpx 20rpx;border-bottom:2rpx solid #ddd6c9}.rule-main{min-width:0;flex:1}.rule-title,.rule-formula{display:block}.rule-title{font-size:25rpx;font-weight:700}.rule-formula{margin-top:7rpx;color:#6c756e;font-size:21rpx}.rule-points{flex:none;color:#315b40;font-size:26rpx;font-weight:700}.workload-note{margin-top:22rpx;padding:20rpx 22rpx;border-left:6rpx solid #c58a2b;background:#f0e2c7;color:#554d40;font-size:21rpx;line-height:1.65}

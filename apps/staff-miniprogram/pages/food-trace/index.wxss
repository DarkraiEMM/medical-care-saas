.food-form{margin:26rpx 0;padding:26rpx;background:#fff;border:1rpx solid #d3ccbe}.field{display:block;margin-bottom:22rpx}.field text,.field-heading{display:block;margin-bottom:10rpx;font-weight:700}.field input{min-height:76rpx;padding:0 18rpx;background:#f8f5ee;border:1rpx solid #cfc7b8}.photo-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-bottom:20rpx}.photo-item,.photo-add{height:190rpx;background:#f5f1e8;border:1rpx dashed #8a948c}.photo-item image{width:100%;height:140rpx}.photo-item button{height:48rpx;line-height:48rpx;font-size:21rpx}.photo-add text{display:block}.photo-add text:first-child{font-size:48rpx}.audio-button{margin:18rpx 0;background:#f0dfbf!important;color:#704b19!important}.audio-button.recording{background:#f4dfdb!important;color:#8c332a!important}.media-ready{display:block;margin:-6rpx 0 18rpx;color:#3f684f}.recent-title{display:block;padding-bottom:14rpx;border-bottom:2rpx solid #17211b;font-size:30rpx;font-weight:700}.recent-row{display:flex;justify-content:space-between;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #d5cec0}.recent-row text{display:block}.recent-row view text+text{margin-top:6rpx;color:#6a746d;font-size:22rpx}
